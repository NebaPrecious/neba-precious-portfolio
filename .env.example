# -----------------------------------------------------------------------------
# Neba Precious Portfolio — environment variables
# Copy to .env.local for local development. Never commit real values.
# On Vercel: Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Public base URL (used for metadata, sitemap, canonical URLs, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# --- Database (required) -----------------------------------------------------
# Local: any Postgres 14+. Production: Neon (use the *pooled* connection string).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/portfolio
# Optional: direct (non-pooled) URL for running migrations against Neon.
# DIRECT_DATABASE_URL=

# --- Security (required in production) --------------------------------------
# 32+ random characters. Keys the rate-limit hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Media storage: Cloudinary (required in production for uploads) ---------
# Dashboard → Settings → API Keys. The secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix inside your Cloudinary account.
CLOUDINARY_FOLDER=portfolio
# Dev only: when Cloudinary is not configured, uploads are written to
# public/uploads/dev. Set to "false" to disable. Always disabled in production.
# ALLOW_LOCAL_UPLOADS=true

# --- Email notifications: Resend (optional) ---------------------------------
# Without these, enquiries are still saved to the admin inbox.
RESEND_API_KEY=
# Where enquiry notifications are delivered.
CONTACT_TO_EMAIL=
# Sender. "onboarding@resend.dev" only delivers to your own Resend account
# email; verify a domain in Resend to send from your own address.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --- One-off: non-interactive admin provisioning (CI / first deploy) --------
# Only set these for the duration of `npm run admin:create`, then remove them.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
